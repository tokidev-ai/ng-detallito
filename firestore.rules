rules_version = '2';

// Aislamiento multitenant. La UI oculta; esto es lo que manda.
//
// ponytail: la membresía vive en `memberEmails` del propio doc del tenant (por
// correo, no por uid): agregar un empleado por email alcanza para que entre, sin
// custom claims ni sincronizar uids. Si algún día hay cientos de empleados por
// comercio, esto pasa a claims.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function tenant(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }

    function isMember(tenantId) {
      return signedIn() && myEmail() in tenant(tenantId).memberEmails;
    }

    // ¿tiene el permiso `p`? Lee su doc de staff (clave = su correo).
    function hasPerm(tenantId, p) {
      return isMember(tenantId)
             && get(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(myEmail())).data.perms[p] == true;
    }

    // Superadmin = nosotros, la startup. Un doc por uid, otorgado a mano.
    // ponytail: exists() sobre una ruta fija, no custom claims: cero Functions.
    function isSuperadmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function isOwner(tenantId) {
      return signedIn() && request.auth.uid == tenant(tenantId).ownerUid;
    }

    // El libro de cobros del superadmin: lee las cards de TODOS los comercios con
    // una consulta collectionGroup('cards'). Solo lectura; escribir sigue siendo
    // cosa de cada comercio (reglas de abajo).
    match /{path=**}/cards/{code} {
      allow read: if isSuperadmin();
    }

    // Quién es superadmin: cada uno lee solo el suyo, nadie se lo puede dar.
    match /superadmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /tenants/{tenantId} {
      // Leer el propio doc del tenant no puede usar get(): en una query las reglas
      // se evalúan por documento y `resource` ya trae todo. get() acá rompe el list.
      allow get, list: if resource.data.business.published == true
                       || (request.auth != null && myEmail() in resource.data.memberEmails)
                       || isSuperadmin();

      // el alta la hace el propio dueño y se pone a sí mismo como único miembro.
      // La comisión no la elige el comercio: la negociamos y la ponemos nosotros.
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberEmails == [myEmail()]
                    && request.resource.data.business.slug == tenantId
                    && !('commissionRate' in request.resource.data);

      // el ownerUid no cambia nunca; la lista de miembros solo la toca quien
      // administra el equipo (owner incluido, que tiene manageStaff). La comisión,
      // nunca: si no, un comercio se la bajaría a 0.
      allow update: if isMember(tenantId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commissionRate'])
                    && (request.resource.data.memberEmails == resource.data.memberEmails
                        || isOwner(tenantId) || hasPerm(tenantId, 'manageStaff'));

      // el superadmin solo toca la comisión (entre 0% y 50%), nada más del comercio
      allow update: if isSuperadmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commissionRate'])
                    && request.resource.data.commissionRate is number
                    && request.resource.data.commissionRate >= 0
                    && request.resource.data.commissionRate <= 0.5;

      allow delete: if isOwner(tenantId);

      // saldos y empleados nunca salen del comercio…
      match /cards/{code} {
        allow read, write: if isMember(tenantId);

        // …salvo la carta puntual: quien recibe el regalo la abre por su código
        // (el código es el secreto). Solo get, nunca list, y con el comercio publicado.
        allow get: if tenant(tenantId).business.published == true;

        // la página pública emite la gift card al comprar, sin sesión.
        // ponytail: sin pago ni verificación — cualquiera puede crear una carta.
        // Antes de producción esto va detrás de una Cloud Function/pasarela; acá
        // solo se valida la forma (código == id, saldo == valor, valor > 0).
        allow create: if tenant(tenantId).business.published == true
                      && request.resource.data.code == code
                      && request.resource.data.value is number
                      && request.resource.data.value > 0
                      && request.resource.data.balance == request.resource.data.value;
      }
      match /redemptions/{id} {
        allow read: if isMember(tenantId);
        allow create: if isMember(tenantId);
        allow update, delete: if false;   // append-only: el saldo se recalcula
      }
      match /staff/{email} {
        allow read: if isMember(tenantId);
        allow write: if isOwner(tenantId) || hasPerm(tenantId, 'manageStaff');
      }
    }
  }
}
