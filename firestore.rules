rules_version = '2';

// Aislamiento multitenant. La UI oculta; esto es lo que manda.
//
// ponytail: la membresía vive en `memberEmails` del propio doc del tenant (por
// correo, no por uid): agregar un empleado por email alcanza para que entre, sin
// custom claims ni sincronizar uids. Si algún día hay cientos de empleados por
// comercio, esto pasa a claims.
service cloud.firestore {
  match /databases/{database}/documents {

    // Correo verificado (Google siempre lo está). Sin esto, si algún día se habilita
    // email/contraseña, cualquiera se registra con el correo de un empleado y entra.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function tenant(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }

    function page(tenantId) {
      return get(/databases/$(database)/documents/pages/$(tenantId)).data;
    }

    function isMember(tenantId) {
      return signedIn() && myEmail() in tenant(tenantId).memberEmails;
    }

    // ¿tiene el permiso `p`? Lee su doc de staff (clave = su correo).
    function hasPerm(tenantId, p) {
      return isMember(tenantId)
             && get(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(myEmail())).data.perms[p] == true;
    }

    // Superadmin = nosotros, la startup. Un doc por uid, otorgado a mano.
    // ponytail: exists() sobre una ruta fija, no custom claims: cero Functions.
    function isSuperadmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    // Dueño por uid, o por su doc de staff con role 'owner' (mismo criterio que
    // la app: si el uid cambia, el correo sigue siendo el dueño). Ese doc solo lo
    // escribe el dueño: ver /staff abajo.
    function ownerOrPerm(tenantId, p) {
      return isOwner(tenantId) || hasPerm(tenantId, p);
    }

    function isOwner(tenantId) {
      return signedIn()
             && (request.auth.uid == tenant(tenantId).ownerUid
                 || (isMember(tenantId)
                     && get(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(myEmail())).data.role == 'owner'));
    }

    // El libro de cobros del superadmin: lee las cards de TODOS los comercios con
    // una consulta collectionGroup('cards'). Solo lectura; escribir sigue siendo
    // cosa de cada comercio (reglas de abajo).
    match /{path=**}/cards/{code} {
      allow read: if isSuperadmin();
    }

    // Quién es superadmin: cada uno lee solo el suyo, nadie se lo puede dar.
    // Texto que escribe la gente: con tope y sin < > ni caracteres de control (sí
    // saltos de línea). Angular ya escapa al mostrar; esto es la segunda barrera y
    // la única que no depende de nuestra app.
    function okText(s, max) {
      return s is string && s.size() <= max && s.matches('(?:[^<>\\p{Cc}]|\\n)*');
    }

    // Los campos de la página que cambian en esta escritura (o todos, al crearla).
    function okBusiness(b, keys) {
      return keys.hasOnly(['name', 'slug', 'description', 'logoUrl', 'color', 'published',
                           'validityMonths', 'terms', 'suggestedAmounts', 'cardStyle',
                           'address', 'location'])
          && (!('name' in keys) || (okText(b.name, 60) && b.name.size() > 0))
          && (!('slug' in keys) || (b.slug is string && b.slug.matches('[a-z0-9-]{1,40}')))
          && (!('description' in keys) || okText(b.description, 160))
          && (!('address' in keys) || okText(b.address, 160))
          && (!('terms' in keys) || okText(b.terms, 500))
          && (!('color' in keys) || (b.color is string && b.color.matches('#[0-9a-fA-F]{6}')))
          // el logo es una imagen embebida (ver logoDataUrl), nunca un link a otro lado
          && (!('logoUrl' in keys) || b.logoUrl == null
              || (b.logoUrl is string && b.logoUrl.size() <= 60000
                  && b.logoUrl.matches('data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+')))
          && (!('cardStyle' in keys) || b.cardStyle in ['degradado', 'logo', 'cubierta', 'claro', 'oscuro'])
          && (!('published' in keys) || b.published is bool)
          && (!('validityMonths' in keys) || (b.validityMonths is int && b.validityMonths > 0 && b.validityMonths <= 60))
          && (!('suggestedAmounts' in keys) || (b.suggestedAmounts is list && b.suggestedAmounts.size() <= 20))
          && (!('location' in keys) || b.location == null
              || (b.location is map && b.location.keys().hasOnly(['lat', 'lng'])
                  && b.location.lat is number && b.location.lng is number));
    }

    function okBank(b) {
      return b is map && b.keys().hasOnly(['bank', 'account', 'holder', 'nit'])
          && okText(b.get('bank', ''), 40) && okText(b.get('account', ''), 30)
          && okText(b.get('holder', ''), 80) && okText(b.get('nit', ''), 20);
    }

    function okEmail(e) {
      return e is string && e.size() <= 100 && e.matches('[^<>\\s@]+@[^<>\\s@]+\\.[^<>\\s@]+');
    }

    function ownerPath(uid) { return /databases/$(database)/documents/owners/$(uid); }
    function tenantPath(id) { return /databases/$(database)/documents/tenants/$(id); }

    // +1 al crear un tenant (que no existía y existe después, sin pasarse del tope)
    // o -1 al borrar uno propio (que existía y ya no). La persona no toca su `max`.
    function counterStep(uid) {
      let d = request.resource.data;
      let prev = resource == null ? 0 : resource.data.count;
      let max = resource == null ? 3 : resource.data.get('max', 3);
      return d.keys().hasOnly(['count', 'created', 'deleted', 'max'])
          && d.get('max', 3) == max
          && ((d.count == prev + 1 && d.count <= max
               && d.created is string
               && !exists(tenantPath(d.created)) && existsAfter(tenantPath(d.created)))
              || (resource != null && d.count == prev - 1
                  && d.deleted is string
                  && exists(tenantPath(d.deleted))
                  && get(tenantPath(d.deleted)).data.ownerUid == uid
                  && !existsAfter(tenantPath(d.deleted))));
    }

    // El alta del tenant tiene que subir el contador del dueño en la misma escritura.
    function countedNew(tenantId) {
      let path = ownerPath(request.auth.uid);
      let prev = exists(path) ? get(path).data.count : 0;
      return existsAfter(path)
          && getAfter(path).data.count == prev + 1
          && getAfter(path).data.created == tenantId;
    }

    match /superadmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Cuántos comercios creó cada persona: `owners/{uid}` = { count, created, deleted, max? }.
    // Las reglas no pueden contar documentos, así que el alta y la baja del tenant
    // mueven este contador en la misma escritura (batch) y lo prueban con
    // `created`/`deleted` = el id del tenant. `max` (3 si falta) solo lo cambia el
    // superadmin, cuando alguien nos pide más.
    match /owners/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isSuperadmin();
      allow create, update: if signedIn() && request.auth.uid == uid && counterStep(uid);
      allow update: if isSuperadmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['max'])
                    && request.resource.data.max is int && request.resource.data.max >= 0;
    }

    // La página pública del comercio: `pages/{id}` = { business }. Es lo único que ve
    // alguien de afuera. Lo privado (equipo, cuenta bancaria, comisión) vive en
    // `tenants/{id}`, porque las reglas no pueden ocultar campos sueltos de un doc.
    match /pages/{tenantId} {
      // get de una que no existe: así el wizard sabe si un link está libre
      allow get: if resource == null
                 || resource.data.business.published == true
                 || isMember(tenantId) || isSuperadmin();
      allow list: if resource.data.business.published == true || isSuperadmin();
      // la crea el dueño junto con su tenant; el id es el slug y no cambia
      allow create: if isOwner(tenantId)
                    && request.resource.data.keys().hasOnly(['business'])
                    && request.resource.data.business.slug == tenantId
                    && okBusiness(request.resource.data.business, request.resource.data.business.keys());
      allow update: if (isOwner(tenantId)
                        || hasPerm(tenantId, 'manageBranding') || hasPerm(tenantId, 'manageProducts'))
                    && request.resource.data.keys().hasOnly(['business'])
                    && request.resource.data.business.slug == resource.data.business.slug
                    && okBusiness(request.resource.data.business,
                                  request.resource.data.business.diff(resource.data.business).affectedKeys());
      allow delete: if isOwner(tenantId);
    }

    match /tenants/{tenantId} {
      // Leer el propio doc del tenant no puede usar get(): en una query las reglas
      // se evalúan por documento y `resource` ya trae todo. get() acá rompe el list.
      allow get, list: if (signedIn() && myEmail() in resource.data.memberEmails)
                       || isSuperadmin();

      // el alta la hace el propio dueño y se pone a sí mismo como único miembro.
      // La comisión no la elige el comercio: la negociamos y la ponemos nosotros.
      allow create: if signedIn()
                    && countedNew(tenantId)
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberEmails == [myEmail()]
                    && request.resource.data.keys().hasOnly(['ownerUid', 'memberEmails', 'bank'])
                    && okBank(request.resource.data.bank);

      // El dueño cambia todo menos ownerUid y la comisión (si no, se la bajaría a 0):
      // la cuenta bancaria es solo suya, o un empleado se desviaría los pagos.
      // Un empleado solo toca memberEmails, con manageStaff y sin sacar al dueño
      // (memberEmails[0]).
      allow update: if isMember(tenantId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && (!('bank' in request.resource.data.diff(resource.data).affectedKeys())
                        || okBank(request.resource.data.bank))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commissionRate'])
                    && (isOwner(tenantId)
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberEmails'])
                            && hasPerm(tenantId, 'manageStaff')
                            && request.resource.data.memberEmails[0] == resource.data.memberEmails[0]));

      // el superadmin solo toca la comisión (entre 0% y 50%), nada más del comercio
      allow update: if isSuperadmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commissionRate'])
                    && request.resource.data.commissionRate is number
                    && request.resource.data.commissionRate >= 0
                    && request.resource.data.commissionRate <= 0.5;

      allow delete: if isOwner(tenantId);

      // saldos y empleados nunca salen del comercio…
      match /cards/{code} {
        allow read: if isMember(tenantId);
        // emitir, editar y borrar: quien tiene el tab Gift cards (o el dueño)
        allow delete: if ownerOrPerm(tenantId, 'viewCards');
        allow create, update: if ownerOrPerm(tenantId, 'viewCards')
                              && okText(request.resource.data.get('to', ''), 80)
                              && okText(request.resource.data.get('from', ''), 80);
        // canjear: solo baja el saldo, nada más de la carta
        allow update: if hasPerm(tenantId, 'redeem')
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])
                      && request.resource.data.balance is number
                      && request.resource.data.balance >= 0
                      && request.resource.data.balance < resource.data.balance;

        // …salvo la carta puntual: quien recibe el regalo la abre por su código
        // (el código es el secreto). Solo get, nunca list, y con el comercio publicado.
        allow get: if page(tenantId).business.published == true;

        // la página pública emite la gift card al comprar, sin sesión.
        // ponytail: sin pago ni verificación — cualquiera puede crear una carta.
        // Antes de producción esto va detrás de una Cloud Function/pasarela; acá
        // solo se valida la forma (código == id, saldo == valor, valor > 0).
        allow create: if page(tenantId).business.published == true
                      && request.resource.data.keys().hasOnly(['code', 'to', 'from', 'value', 'balance', 'expires', 'soldAt', 'channel'])
                      && request.resource.data.channel == 'qr'
                      && okText(request.resource.data.to, 40)
                      && okText(request.resource.data.get('from', ''), 40)
                      && request.resource.data.expires is string && request.resource.data.expires.size() == 10
                      && request.resource.data.code == code
                      && request.resource.data.value is number
                      && request.resource.data.value > 0
                      // el cliente solo compra los montos que puso el comercio
                      && request.resource.data.value in page(tenantId).business.suggestedAmounts
                      && request.resource.data.balance == request.resource.data.value;
      }
      match /redemptions/{id} {
        allow read: if isMember(tenantId);
        allow create: if ownerOrPerm(tenantId, 'redeem')
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0;
        allow update, delete: if false;   // append-only: el saldo se recalcula
      }
      match /staff/{email} {
        allow read: if isMember(tenantId);
        // quien gestiona el equipo toca empleados, nunca al dueño ni crea otro dueño
        allow write: if (request.resource == null
                         || (okEmail(email) && request.resource.data.email == email))
                     && (isOwner(tenantId)
                     || (hasPerm(tenantId, 'manageStaff')
                         && (resource == null || resource.data.role == 'staff')
                         && (request.resource == null || request.resource.data.role == 'staff')));
      }
    }
  }
}
